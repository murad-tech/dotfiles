# command to apply custom configuration file path:
# ghostty --config-file=/path/to/your/custom/config
# 
# or open ghosty settings txt file add line below:
# config-file = /path/to/your/custom/config

# style
theme = Gruvbox Dark
background-opacity = 0.9
background-blur = true

# text
shell-integration-features = no-cursor
cursor-style = block
cursor-text = #000000
cursor-style-blink = false

# navigation
keybind = ctrl+k=scroll_page_up
keybind = ctrl+j=scroll_page_down
